# Copy this file to .env and fill in real values. Never commit .env.

# Embeddings
VOYAGE_API_KEY = pa-...

# LLMs
HUGGINGFACEHUB_API_TOKEN = ..
NVIDIA_API_KEY = nvapi-..
NVIDIA_MODEL = openai/gpt-oss-20b
GROQ_API_KEY = ...

# Use the session pooler or a direct connection (not the transaction pooler) for the LangGraph checkpointer
DATABASE_URL=

# FastAPI backend Supabase
SUPABASE_URL = ....
SUPABASE_SECRET_KEY = ...

# React frontend Supabase
VITE_SUPABASE_URL=...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=decodeit

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173